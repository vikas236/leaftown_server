{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "verbatimModuleSyntax": false,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  }
}
